# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-very-long-random-secret-key

# MongoDB
MONGO_URI=mongodb://localhost:27017/egc_portal

# JWT
JWT_SECRET_KEY=change-this-to-another-very-long-random-secret-key
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ERPNext (stock REST API)
ERP_BASE_URL=https://erp.egc-me.com
ERP_API_KEY=your-erp-api-key
ERP_API_SECRET=your-erp-api-secret

# egc_hr (versioned API - Work Record import, Leave, Project Site/Supervisors).
# Dedicated User (egc-app@egc.local, role "EGC Integration Agent" only) - see
# docs/EGC_APP_INTEGRATION.md in the egc-erp-hr repo. Independently configurable
# from ERP_BASE_URL above even though it's often the same physical site.
EGC_HR_BASE_URL=https://erp.egc-me.com
EGC_HR_API_KEY=your-egc-hr-api-key
EGC_HR_API_SECRET=your-egc-hr-api-secret

# Web Push (VAPID) - generate once with: python -c "from pywebpush import webpush; ..."
# or `vapid --gen` (py-vapid, a pywebpush dependency)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@egc-me.com

# System Admin (pre-installed)
SYSADMIN_USERNAME=sysadmin
SYSADMIN_PASSWORD=Admin@123!  # Will be forced to change on first login
